# Skopiuj do docker/.env (i .env.functions) na VPS. Nie commituj prawdziwych wartości.

# --- API (aplikacje Vite + n8n) ---
# VITE_SUPABASE_URL / SUPABASE_URL
SUPABASE_PUBLIC_URL=https://db.j0zek.pl
# ANON_KEY i SERVICE_ROLE_KEY z self-hosted (Kong JWT) — inne niż Cloud
ANON_KEY=
SERVICE_ROLE_KEY=
JWT_SECRET=
SECRET_KEY_BASE=

# --- Postgres (tylko sieć Dockera / localhost na VPS) ---
POSTGRES_PASSWORD=
# VPS_DATABASE_URL=postgres://postgres:HASLO@db:5432/postgres

# --- Auth (GoTrue) ---
API_EXTERNAL_URL=https://db.j0zek.pl
GOTRUE_SITE_URL=https://domio.com.pl
# Coolify compose maps ADDITIONAL_REDIRECT_URLS -> GOTRUE_URI_ALLOW_LIST
ADDITIONAL_REDIRECT_URLS=https://domio.com.pl,https://domio.com.pl/**,https://www.domio.com.pl,https://www.domio.com.pl/**,https://udomio.com.pl,https://udomio.com.pl/**,https://www.udomio.com.pl,https://www.udomio.com.pl/**,https://test.udomio.com.pl,https://test.udomio.com.pl/**,https://admin.domio.com.pl,https://admin.domio.com.pl/**,https://test.admin.domio.com.pl,https://test.admin.domio.com.pl/**,https://adm.domio.com.pl,https://adm.domio.com.pl/**,https://test.adm.domio.com.pl,https://test.adm.domio.com.pl/**,https://cleaning.domio.com.pl,https://cleaning.domio.com.pl/**,https://serwis.domio.com.pl,https://serwis.domio.com.pl/**,https://home.domio.com.pl,https://home.domio.com.pl/**,https://test.home.domio.com.pl,https://test.home.domio.com.pl/**,https://flota.domio.com.pl,https://flota.domio.com.pl/**,http://localhost:5173,http://localhost:5173/**

# SMTP (maile Auth: reset hasła, potwierdzenie, zaproszenia)
SMTP_ADMIN_EMAIL=biuro@domio.com.pl
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=DOMIO

# OAuth Google (panel logowania: signInWithOAuth provider google)
GOTRUE_EXTERNAL_GOOGLE_ENABLED=true
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=https://db.j0zek.pl/auth/v1/callback

# OAuth Facebook (panel: signInWithOAuth provider facebook)
GOTRUE_EXTERNAL_FACEBOOK_ENABLED=true
GOTRUE_EXTERNAL_FACEBOOK_CLIENT_ID=
GOTRUE_EXTERNAL_FACEBOOK_SECRET=
GOTRUE_EXTERNAL_FACEBOOK_REDIRECT_URI=https://db.j0zek.pl/auth/v1/callback

# --- Edge Functions (.env.functions) ---
SUPABASE_URL=https://db.j0zek.pl
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GUS_BIR_KEY=
GUS_BIR_ENV=prod
LEGAL_WELCOME_N8N_WEBHOOK_URL=https://n8n.j0zek.pl/webhook/legal-welcome-dispatch
CONSENT_IP_SALT=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:biuro@domio.com.pl
SOP_CRON_SECRET=
GEMINI_API_KEY=

# --- Cron generate-sop-tasks (po wdrożeniu functions) ---
# nagłówek x-domio-cron-secret = SOP_CRON_SECRET
# URL: https://db.j0zek.pl/functions/v1/generate-sop-tasks
